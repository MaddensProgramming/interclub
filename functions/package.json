{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --project interclub-668f3 --only functions:updateRoundTimed",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/*.test.cjs",
    "preview:season": "npm run build && node lib/previewSeason.js",
    "check:source": "npm run build && node lib/checkSource.js",
    "check:published": "npm run build && node lib/checkPublishedSeason.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "csv-parser": "^3.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "fs": "^0.0.1-security",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.5.0",
    "typescript": "^4.9.0"
  },
  "overrides": {
    "ts-deepmerge": "8.0.0",
    "uuid": "11.1.1"
  },
  "private": true
}
